<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartClinicSystem</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-staff-snake"></i> SmartClinicSystem
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Patients" asp-action="Index">Patients</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Doctors" asp-action="Index">Doctors</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index">Appointments</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Dashboard">Admin Dashboard</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("IsAdmin") == "true")
                        {
                            <li class="nav-item"><span class="nav-link text-white-50">Hi, @Context.Session.GetString("AdminName")</span></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Admin Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3 text-center">
        <div class="container">
            &copy; @DateTime.Now.Year - SmartClinicSystem &mdash; Built with ASP.NET Core MVC
        </div>
    </footer>

    <!-- AI Chat Assistant Widget -->
    <div id="chatToggleBtn" class="chat-toggle-btn" title="AI Symptom Assistant">
        <i class="fa-solid fa-robot"></i>
    </div>
    <div id="chatWindow" class="chat-window d-none">
        <div class="chat-header">
            <span><i class="fa-solid fa-robot"></i> AI Symptom Assistant</span>
            <span id="chatCloseBtn" style="cursor:pointer;">&times;</span>
        </div>
        <div id="chatBody" class="chat-body">
            <div class="chat-msg bot">Hi! I'm the SmartClinic AI Assistant. Describe your symptoms and I'll give you basic guidance.</div>
        </div>
        <div class="chat-input-area">
            <input type="text" id="chatInput" class="form-control" placeholder="Type your symptom..." />
            <button id="chatSendBtn" class="btn btn-primary btn-sm"><i class="fa-solid fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/chatbot.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
