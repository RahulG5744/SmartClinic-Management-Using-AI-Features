    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Prescription
@{
    ViewData["Title"] = "Edit Prescription";
    var appointment = ViewBag.Appointment as Appointment;
}

<h2><i class="fa-solid fa-file-pen"></i> Edit Prescription</h2>

@if (appointment != null)
{
    <div class="alert alert-light border mb-3">
        <strong>Patient:</strong> @appointment.Patient?.FullName &nbsp; | &nbsp;
        <strong>Visit Date:</strong> @appointment.AppointmentDate.ToShortDateString()
    </div>
}

<div class="card p-4" style="max-width:700px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="AppointmentId" />
        <input type="hidden" asp-for="CreatedOn" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Diagnosis" class="form-label"></label>
            <input asp-for="Diagnosis" class="form-control" />
            <span asp-validation-for="Diagnosis" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Medicines" class="form-label"></label>
            <textarea asp-for="Medicines" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Medicines" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="FollowUpDate" class="form-label"></label>
            <input asp-for="FollowUpDate" class="form-control" type="date" />
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-controller="Appointments" asp-action="Details" asp-route-id="@Model.AppointmentId" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}