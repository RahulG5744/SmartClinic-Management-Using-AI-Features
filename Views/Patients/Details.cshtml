@model Patient
@{
    ViewData["Title"] = "Patient Details";
}

<h2><i class="fa-solid fa-id-card"></i> Patient Details</h2>

<div class="card p-4 mt-3" style="max-width:700px;">
    <dl class="row">
        <dt class="col-sm-4">Full Name</dt>
        <dd class="col-sm-8">@Model.FullName</dd>

        <dt class="col-sm-4">Age</dt>
        <dd class="col-sm-8">@Model.Age</dd>

        <dt class="col-sm-4">Gender</dt>
        <dd class="col-sm-8">@Model.Gender</dd>

        <dt class="col-sm-4">Phone</dt>
        <dd class="col-sm-8">@Model.Phone</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4">Address</dt>
        <dd class="col-sm-8">@Model.Address</dd>

        <dt class="col-sm-4">Medical History</dt>
        <dd class="col-sm-8">@Model.MedicalHistory</dd>

        <dt class="col-sm-4">Registered On</dt>
        <dd class="col-sm-8">@Model.RegisteredOn.ToString("dd MMM yyyy")</dd>
    </dl>

    <h5 class="mt-3">Appointment History</h5>
    @if (Model.Appointments != null && Model.Appointments.Any())
    {
        <ul class="list-group">
        @foreach (var a in Model.Appointments)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@a.Doctor?.FullName - @a.AppointmentDate.ToShortDateString()</span>
                <span class="badge bg-secondary">@a.Status</span>
            </li>
        }
        </ul>
    }
    else
    {
        <p class="text-muted">No appointments yet.</p>
    }

    <a asp-action="Index" class="btn btn-secondary mt-3">Back to List</a>
</div>
