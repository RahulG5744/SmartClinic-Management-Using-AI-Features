@model Appointment
@{
    ViewData["Title"] = "Edit Appointment";
}

<h2><i class="fa-solid fa-calendar-pen"></i> Edit Appointment</h2>

<div class="card p-4 mt-3" style="max-width:700px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedOn" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Patient</label>
            <select asp-for="PatientId" asp-items="ViewBag.PatientId" class="form-select"></select>
        </div>
        <div class="mb-3">
            <label class="form-label">Doctor</label>
            <select asp-for="DoctorId" asp-items="ViewBag.DoctorId" class="form-select"></select>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="AppointmentDate" class="form-label"></label>
                <input asp-for="AppointmentDate" class="form-control" type="date" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="AppointmentTime" class="form-label"></label>
                <input asp-for="AppointmentTime" class="form-control" type="time" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Reason" class="form-label"></label>
            <textarea asp-for="Reason" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AppointmentStatus>()"></select>
        </div>

        <button type="submit" class="btn btn-warning">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
