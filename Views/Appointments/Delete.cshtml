@model Appointment
@{
    ViewData["Title"] = "Delete Appointment";
}

<h2 class="text-danger"><i class="fa-solid fa-trash"></i> Delete Appointment</h2>
<p>Are you sure you want to delete this appointment?</p>

<div class="card p-4 mt-3" style="max-width:700px;">
    <dl class="row">
        <dt class="col-sm-4">Patient</dt>
        <dd class="col-sm-8">@Model.Patient?.FullName</dd>
        <dt class="col-sm-4">Doctor</dt>
        <dd class="col-sm-8">@Model.Doctor?.FullName</dd>
        <dt class="col-sm-4">Date</dt>
        <dd class="col-sm-8">@Model.AppointmentDate.ToShortDateString()</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
