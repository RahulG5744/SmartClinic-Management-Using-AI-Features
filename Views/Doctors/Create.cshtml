@model Doctor
@{
    ViewData["Title"] = "Add Doctor";
}

<h2><i class="fa-solid fa-user-doctor"></i> Add New Doctor</h2>

<div class="card p-4 mt-3" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Specialization" class="form-label"></label>
            <input asp-for="Specialization" class="form-control" />
            <span asp-validation-for="Specialization" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="ExperienceYears" class="form-label"></label>
            <input asp-for="ExperienceYears" class="form-control" />
            <span asp-validation-for="ExperienceYears" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="AvailableFrom" class="form-label"></label>
                <input asp-for="AvailableFrom" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="AvailableTo" class="form-label"></label>
                <input asp-for="AvailableTo" class="form-control" />
            </div>
        </div>

        <button type="submit" class="btn btn-success">Save Doctor</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
