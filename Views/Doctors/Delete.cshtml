@model Doctor
@{
    ViewData["Title"] = "Delete Doctor";
}

<h2 class="text-danger"><i class="fa-solid fa-trash"></i> Delete Doctor</h2>
<p>Are you sure you want to delete this doctor record?</p>

<div class="card p-4 mt-3" style="max-width:700px;">
    <dl class="row">
        <dt class="col-sm-4">Full Name</dt>
        <dd class="col-sm-8">@Model.FullName</dd>
        <dt class="col-sm-4">Specialization</dt>
        <dd class="col-sm-8">@Model.Specialization</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
